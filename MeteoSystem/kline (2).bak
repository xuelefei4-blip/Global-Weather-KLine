<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <link rel="icon" href="static/images/logo.svg" type="image/svg+xml">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- 核心标题：融合 WeatherCandle 品牌与中英高搜索量词 -->
    <title>全球温度K线 / 气温蜡烛图 - WeatherCandle 全球历史天气走势可视化 | Temperature Candlestick Chart</title>

    <!-- 核心描述 -->
    <meta name="description" content="WeatherCandle 全球温度K线（气温蜡烛图 / Temperature Candlestick Chart）可视化平台。创新将金融K线/OHLC原理应用于气象：每日最高温、最低温、开盘温、收盘温绘制成蜡烛图，直观展示2015至2026年历史气温波动与湿度变化，支持全球主要城市与3D地球交互。">

    <!-- 高意图双语关键词 -->
    <meta name="keywords" content="全球温度K线,气温蜡烛图,温度K线图,气温K线图,天气蜡烛图,气象蜡烛图,气温OHLC,历史气温蜡烛图,WeatherCandle,Temperature Candlestick Chart,Weather Candlestick,Temperature OHLC Chart,Climate Data Visualization">

    <!-- 规范链接已切换为新独立域名 -->
    <link rel="canonical" href="https://www.weathercandle.com/">
    <meta name="robots" content="index,follow">

    <!-- 版本与作者 -->
    <meta name="generator" content="WeatherCandle Monitor v2026.10 by Kingcat66695111">
