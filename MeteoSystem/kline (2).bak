    <!-- 第三方依赖 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://unpkg.com/lightweight-charts@4.1.1/dist/lightweight-charts.standalone.production.js"></script>
    <script src="https://unpkg.com/globe.gl"></script>

    <!-- 全局样式 -->
    <link rel="stylesheet" href="static/css/style.css">

    <!-- 轻量级增量控件样式（不破坏原有 style.css） -->
    <style>
        .icon-action-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: inherit;
            border-radius: 6px;
            padding: 4px 9px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .icon-action-btn:hover {
            background: rgba(38, 166, 154, 0.25);
            border-color: #26a69a;
        }
        .copy-toast {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: rgba(38, 166, 154, 0.95);
            color: #fff;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            opacity: 0;
            pointer-events: none;
            transition: all 0.25s ease;
            z-index: 9999;
        }
        .copy-toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <!-- 双语搜索引擎语义解析层 -->
    <div style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;" aria-hidden="true">
        <h1>WeatherCandle 全球温度K线与气温蜡烛图可视化分析系统 - Temperature Candlestick Chart & Weather K-Line Monitor</h1>
        <article>
            <h2>气温蜡烛图（温度K线图）核心概念与定义</h2>
            <p>
                WeatherCandle 是专为气象数据设计的<strong>全球温度K线（Temperature Candlestick Chart）</strong>分析平台。
                一目了然地展示每日最高温、最低温和温度变化，追踪全球主要城市的天气模式，时间范围可从小时、日、周、月到年度自由调整。
                适合天气爱好者、旅行者、对气候趋势感兴趣以及熟悉金融图表的任何人。
            </p>
            <p>
                An interactive climate monitoring platform that innovatively applies financial candlestick (Temperature K-Line / OHLC) charts to meteorological data. 
                Visualizing daily high temperature, low temperature, open and close temperature alongside relative humidity for major cities worldwide from 2015 to 2026.
            </p>
        </article>
    </div>

    <div class="main-floating-title" id="ui-main-title">Meteorological Monitor</div>

    <div id="chart-wrapper">
        <img src="static/images/pixel-hamster.png" class="pixel-hamster" alt="hamster">

        <div class="header-panel">
            <!-- 左侧：K线周期粒度 + 视野时间跨度 -->
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <div class="btn-group" title="K-Line Interval / K线周期">
                    <label><input type="radio" name="res" value="H"><span id="res-h">H</span></label>
                    <label><input type="radio" name="res" value="D" checked><span id="res-d">D</span></label>
                    <label><input type="radio" name="res" value="W"><span id="res-w">W</span></label>
                    <label><input type="radio" name="res" value="M"><span id="res-m">M</span></label>
                    <label><input type="radio" name="res" value="Y"><span id="res-y">Y</span></label>
                </div>

                <!-- 借鉴参考项目的视野跨度快捷切换（默认 1Y 展现四季正弦波） -->
                <div class="btn-group" title="Visible Span / 视野范围">
                    <label><input type="radio" name="span" value="90"><span>3M</span></label>
                    <label><input type="radio" name="span" value="180"><span>6M</span></label>
                    <label><input type="radio" name="span" value="365" checked><span>1Y</span></label>
                    <label><input type="radio" name="span" value="1095"><span>3Y</span></label>
                    <label><input type="radio" name="span" value="ALL"><span>ALL</span></label>
                </div>
            </div>

            <!-- 右侧：语言切换 + 主题 + 双城对比 + 副图指标 -->
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <button id="lang-btn" class="icon-action-btn" title="Switch Language / 切换语言">🌐 中文</button>
                <select id="theme-select" class="theme-select" title="Switch Theme">
                    <option value="dark">🌙 Dark</option>
                    <option value="light">☀️ Light</option>
                    <option value="ocean">🌊 Ocean Blue</option>
                    <option value="cyberpunk">⚡ Cyberpunk</option>
                </select>
                <button id="lab-btn" class="lab-btn">Compare Lab ➔</button>
                <div class="btn-group">
                    <label><input type="checkbox" id="hum-check" checked><span id="ui-hum-label">Humidity %</span></label>
                    <label><span class="btn-disabled" id="ui-pres-label">Pressure</span></label>
                    <label><span class="btn-disabled" id="ui-wind-label">Wind</span></label>
                </div>
            </div>
        </div>

        <div id="main-chart-container">
            <div id="tooltip" class="custom-tooltip"></div>
        </div>
    </div>

    <div class="social-links">
        <a href="#" id="share-x" target="_blank" title="Share current city on X"><i class="fa-brands fa-x-twitter"></i></a>
        <a href="#" id="share-reddit" target="_blank" title="Share current city on Reddit"><i class="fa-brands fa-reddit-alien"></i></a>
        <a href="#" id="copy-link-btn" title="Copy current city link / 复制当前城市链接"><i class="fa-solid fa-link"></i></a>
        <a href="https://github.com/xuelefei4-blip/Global-Weather-KLine" target="_blank" title="View on GitHub"><i class="fa-brands fa-github"></i></a>
    </div>

    <div id="copy-toast" class="copy-toast">🔗 Link copied to clipboard!</div>

    <div class="footer-panel">
        <div class="footer-row">
            <div class="footer-item">
                <span id="ui-search-label">Search & Select Location</span>
                <div style="display:inline-flex; align-items:center; gap:6px;">
                    <input 
                        type="text" 
                        id="location-search-input" 
                        class="city-select" 
                        list="city-list" 
                        placeholder="Type city name..." 
                        style="width: 185px;"
                        autocomplete="off"
                    >
                    <button id="locate-me-btn" class="icon-action-btn" title="Detect my location / 定位当前所在时区城市">📍</button>
                </div>
                <input type="hidden" id="location-selector">
                <datalist id="city-list"></datalist>
            </div>

            <div class="footer-item" style="text-align: center;">
                <span id="ui-coord-label">Coordinates</span>
                <b id="coord-display">--° N, --° W</b>
            </div>

            <div class="footer-item" style="text-align: right;">
                <span id="ui-time-label">Local Time</span>
                <b id="local-clock">00:00:00</b>
            </div>
        </div>
    </div>

    <div class="footer-copyright">
        © 2026 Kingcat66695111 • WeatherCandle.com Climate Visualization Project<br>
        Version: 2026.10 • Built with passion for understanding climate change<br>
        Global Weather & Temperature K-Line Monitor • 全球天气温度K线可视化实验台<br>
        Educational & Non-commercial use only. Commercial use requires permission.<br>
        If this tool helped you, consider supporting it → 
        <a href="https://ko-fi.com/kingcat666" target="_blank" style="color:#00ff7f; text-decoration:none;">Ko-fi</a>
        • Visualizing climate and temperature trends through time-series analysis
    </div>

    <div id="globe-container"></div>
    <div id="selected-city-display">Loading...</div>

    <script>
        const fullYears = [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];

        // 修正了原代码中 London/Paris/Berlin/Beijing/Tokyo 的标准时区与路径
        const major_cities = [
            { name: "New York", id: "nyc", lat: 40.71, lon: -74.00, tz: "America/New_York", path: "static/data/North_America/USA/New_York/", years: fullYears },
            { name: "Los Angeles", id: "lax", lat: 34.05, lon: -118.24, tz: "America/Los_Angeles", path: "static/data/North_America/USA/Los_Angeles/", years: fullYears },
            { name: "Chicago", id: "chi", lat: 41.87, lon: -87.62, tz: "America/Chicago", path: "static/data/North_America/USA/Chicago/", years: fullYears },
            { name: "Toronto", id: "tor", lat: 43.65, lon: -79.38, tz: "America/Toronto", path: "static/data/North_America/Canada/Toronto/", years: fullYears },
            { name: "London", id: "lon", lat: 51.50, lon: -0.12, tz: "Europe/London", path: "static/data/Europe/United_Kingdom/London/", years: fullYears },
            { name: "Paris", id: "par", lat: 48.85, lon: 2.35, tz: "Europe/Paris", path: "static/data/Europe/France/Paris/", years: fullYears },
            { name: "Berlin", id: "ber", lat: 52.52, lon: 13.40, tz: "Europe/Berlin", path: "static/data/Europe/Germany/Berlin/", years: fullYears },
            { name: "Beijing", id: "bj", lat: 39.90, lon: 116.40, tz: "Asia/Shanghai", path: "static/data/Asia/China/Beijing/", years: fullYears },
            { name: "Tokyo", id: "tok", lat: 35.68, lon: 139.76, tz: "Asia/Tokyo", path: "static/data/Asia/Japan/Tokyo/", years: fullYears },
            { name: "Sydney", id: "syd", lat: -33.86, lon: 151.20, tz: "Australia/Sydney", path: "static/data/Oceania/Australia/Sydney/", years: fullYears }
        ];

        const I18N = {
            en: {
                title: "Meteorological Monitor",
                langBtn: "🌐 中文",
                labBtn: "Compare Lab ➔",
                hum: "Humidity %",
                pres: "Pressure",
                wind: "Wind",
                searchLabel: "Search & Select Location",
                searchPlaceholder: "Type city name...",
                coordLabel: "Coordinates",
                timeLabel: "Local Time",
                copied: "🔗 City link copied to clipboard!"
            },
            zh: {
                title: "全球温度K线监控台",
                langBtn: "🌐 EN",
                labBtn: "双城对比 ➔",
                hum: "相对湿度 %",
                pres: "气压",
                wind: "风速",
                searchLabel: "搜索与选择城市",
                searchPlaceholder: "输入城市英文或拼音...",
                coordLabel: "经纬度坐标",
                timeLabel: "当地时间",
                copied: "🔗 当前城市分享链接已复制！"
            }
        };

        function formatStaticPath(p) {
            if (!p) return "";
            let path = p.trim().replace(/\\/g, '/');
            if (path.startsWith('/')) path = path.slice(1);
            if (!path.startsWith('static/')) path = 'static/' + path;
            return path.replace(/\/+/g, '/');
        }

        class ThemeManager {
            constructor(chart) {
                this.chart = chart;
                this.select = document.getElementById('theme-select');
                this.themes = ['dark', 'light', 'ocean', 'cyberpunk'];
                this.themeConfigs = {
                    dark: {
                        className: '',
                        textColor: '#8e94a5',
                        gridColor: 'rgba(255,255,255,0.03)',
                        borderColor: 'rgba(255,255,255,0.1)'
                    },
                    light: {
                        className: 'light-theme',
                        textColor: '#4b5563',
                        gridColor: 'rgba(0,0,0,0.06)',
                        borderColor: 'rgba(0,0,0,0.12)'
                    },
                    ocean: {
                        className: 'ocean-theme',
                        textColor: '#7dd3fc',
                        gridColor: 'rgba(56, 189, 248, 0.05)',
                        borderColor: 'rgba(56, 189, 248, 0.18)'
                    },
                    cyberpunk: {
                        className: 'cyberpunk-theme',
                        textColor: '#f472b6',
                        gridColor: 'rgba(244, 63, 94, 0.06)',
                        borderColor: 'rgba(244, 63, 94, 0.22)'
                    }
                };
                this.init();
            }
            init() {
                const savedTheme = localStorage.getItem('meteo_theme') || 'dark';
                const theme = this.themes.includes(savedTheme) ? savedTheme : 'dark';
                this.applyTheme(theme);

                if (this.select) {
                    this.select.value = theme;
                    this.select.onchange = (e) => this.applyTheme(e.target.value);
                }
            }
            applyTheme(theme) {
                const cfg = this.themeConfigs[theme] || this.themeConfigs['dark'];
                document.body.classList.remove('light-theme', 'ocean-theme', 'cyberpunk-theme');
                if (cfg.className) {
                    document.body.classList.add(cfg.className);
                }
                localStorage.setItem('meteo_theme', theme);
                if (this.select && this.select.value !== theme) {
                    this.select.value = theme;
                }
                this._updateChart(cfg);
            }
            _updateChart(cfg) {
                if (!this.chart) return;
                this.chart.applyOptions({
                    layout: { textColor: cfg.textColor },
                    grid: { vertLines: { color: cfg.gridColor }, horzLines: { color: cfg.gridColor } },
                    timeScale: { borderColor: cfg.borderColor },
                    leftPriceScale: { borderColor: cfg.borderColor }
                });
            }
        }

        class MeteoApp {
            constructor() {
                this.dataCache = new Map();
                this.rawData = [];
                this.locationConfig = {};
                this.cityList = [];
                this.chartIns = null;
                this.globeIns = null;
                this.series = {};
                this.lang = localStorage.getItem('meteo_lang') || 'en';

                this.dom = {
                    container: document.getElementById('main-chart-container'),
                    selector: document.getElementById('location-selector'),
                    clock: document.getElementById('local-clock'),
                    coord: document.getElementById('coord-display'),
                    tooltip: document.getElementById('tooltip'),
                    humCheck: document.getElementById('hum-check')
                };
            }

            async init() {
                this._initChart();
                this._initGlobe();
                new ThemeManager(this.chartIns);
                this._applyLanguage(this.lang);
                await this._loadIndex();
                this._bindEvents();
                this._startClock();

                const urlParams = new URLSearchParams(window.location.search);
                const cityId = urlParams.get('city');

                if (cityId && this.locationConfig[cityId.toLowerCase().trim()]) {
                    this.dom.selector.value = cityId.toLowerCase().trim();
                } else {
                    // 自动根据访客浏览器时区匹配最近城市（若无匹配则回退 nyc）
                    const detectedId = this._detectUserCityId();
                    this.dom.selector.value = detectedId;
                }

                setTimeout(() => {
                    this.changeLocation();
                }, 100);
            }

            _detectUserCityId() {
                try {
                    const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                    if (userTz) {
                        const matched = this.cityList.find(c => c.tz && c.tz.toLowerCase() === userTz.toLowerCase());
                        if (matched) return matched.id;
                        if (userTz.includes('Shanghai') || userTz.includes('Chongqing') || userTz.includes('Urumqi')) {
                            if (this.locationConfig['bj']) return 'bj';
                        }
                    }
                } catch (e) {}
                return this.cityList.length > 0 ? this.cityList[0].id : 'nyc';
            }

            _applyLanguage(lang) {
                this.lang = lang;
                localStorage.setItem('meteo_lang', lang);
                const t = I18N[lang] || I18N.en;
                document.getElementById('ui-main-title').textContent = t.title;
                document.getElementById('lang-btn').textContent = t.langBtn;
                document.getElementById('lab-btn').textContent = t.labBtn;
                document.getElementById('ui-hum-label').textContent = t.hum;
                document.getElementById('ui-pres-label').textContent = t.pres;
                document.getElementById('ui-wind-label').textContent = t.wind;
                document.getElementById('ui-search-label').textContent = t.searchLabel;
                document.getElementById('location-search-input').placeholder = t.searchPlaceholder;
                document.getElementById('ui-coord-label').textContent = t.coordLabel;
                document.getElementById('ui-time-label').textContent = t.timeLabel;
            }

            _initChart() {
                this.chartIns = LightweightCharts.createChart(this.dom.container, {
                    layout: { background: { color: 'transparent' }, textColor: '#8e94a5', fontSize: 10 },
                    grid: { vertLines: { color: 'rgba(255,255,255,0.03)' }, horzLines: { color: 'rgba(255,255,255,0.03)' } },
                    crosshair: {
                        mode: LightweightCharts.CrosshairMode.Normal, 
                        vertLine: { visible: true, labelVisible: true, style: 2, width: 1, color: 'rgba(255, 255, 255, 0.4)' },
                        horzLine: { visible: true, labelVisible: true, style: 2, width: 1, color: 'rgba(255, 255, 255, 0.4)' }
                    },
                    localization: {
                        timeFormatter: (t) => {
                            const d = new Date(t * 1000);
                            return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')} ${String(d.getHours()).padStart(2, '0')}:00`;
                        }
                    },
                    timeScale: { 
                        borderColor: 'rgba(255,255,255,0.1)', timeVisible: true,
                        tickMarkFormatter: (t) => {
                            const d = new Date(t * 1000);
                            return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
                        }
                    },
                    // 左侧纯温度轴（占据上方 74% 空间，避免与底部湿度柱重叠）
                    leftPriceScale: { visible: true, borderColor: 'rgba(255,255,255,0.1)', scaleMargins: { top: 0.05, bottom: 0.24 } },
                    // 右侧纯湿度轴（占据底部 18% 空间，解决左下角标签打架问题）
                    rightPriceScale: { visible: true, borderVisible: false, drawTicks: false, scaleMargins: { top: 0.82, bottom: 0 }, textColor: 'transparent' }
                });

                this.chartIns.applyOptions({
                    watermark: { visible: true, text: "© WeatherCandle.com", fontSize: 11, color: "rgba(255, 255, 255, 0.1)", horzAlign: "right", vertAlign: "bottom" }
                });

                this.series.candle = this.chartIns.addCandlestickSeries({
                    upColor: '#26a69a', downColor: '#ef5350', borderVisible: false, priceLineVisible: true, lastValueVisible: true, priceScaleId: 'left',
                    priceFormat: { type: 'custom', formatter: (p) => (p > 0 ? '+' : '') + p.toFixed(1) + '℃' }
                });

                this.series.hLine = this.chartIns.addLineSeries({
                    color: '#C0392B', lineWidth: 2, priceScaleId: 'left', visible: false, lastValueVisible: false, priceLineVisible: false
                });

                // 湿度绑定到右侧轴 'right'，彻底消除左侧轴底部的重叠标签
                this.series.vol = this.chartIns.addHistogramSeries({
                    priceScaleId: 'right', visible: true,
                    priceFormat: { type: 'custom', formatter: (p) => p.toFixed(1) + '%' }
                });

                this.series.vol.createPriceLine({ price: 35, color: '#f44336', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: 'DRT' });
                this.chartIns.subscribeCrosshairMove(p => this._handleTooltip(p));
            }

            _initGlobe() {
                try {
                    const el = document.getElementById('globe-container');
                    if (!el || typeof Globe === 'undefined') return;
                    this.globeIns = Globe()(el)
                        .globeImageUrl('static/images/earth-blue-marble.jpg')
                        .backgroundColor('rgba(0,0,0,0)').width(100).height(100)
                        .globeCurvatureResolution(0.25).pointResolution(24)
                        .ringColor(() => '#FEFAE0').ringMaxRadius(3).ringPropagationSpeed(1).ringRepeatPeriod(1800);

                    const renderer = this.globeIns.renderer();
                    if (renderer) {
                        renderer.setPixelRatio(window.devicePixelRatio || 2);
                    }

                    const orbitControls = this.globeIns.controls();
                    if (orbitControls) {
                        orbitControls.autoRotate = true;
                        orbitControls.autoRotateSpeed = 0.3;
                    }
                } catch (e) {
                    console.warn("Globe fallback", e);
                }
            }

            async _loadIndex() {
                try {
                    major_cities.forEach(city => {
                        const cid = city.id.toLowerCase().trim();
                        this.cityList.push(city);
                        this.locationConfig[cid] = city;
                        this._addCityToUI(city);
                    });

                    const res = await fetch("static/data/index.json");
                    if (!res.ok) return;
                    const data = await res.json();

                    const visited = new Set();
                    const recursiveLoad = async (items) => {
                        const list = Array.isArray(items) ? items : (items.children || []);
                        for (let it of list) {
                            if (it.path && it.path.endsWith('.json') && !it.id) {
                                const subPath = formatStaticPath(it.path);
                                if (!visited.has(subPath)) {
                                    visited.add(subPath);
                                    const r = await fetch(subPath);
                                    if (r.ok) await recursiveLoad(await r.json());
                                }
                            } else if (it.id && it.name) {
                                const cid = it.id.toLowerCase().trim();
                                if (this.locationConfig[cid]) {
                                    Object.assign(this.locationConfig[cid], it);
                                } else {
                                    it.id = cid;
                                    this.cityList.push(it);
                                    this.locationConfig[cid] = it;
                                    this._addCityToUI(it);
                                }
                            }
                        }
                    };
                    await recursiveLoad(data);
                } catch (e) {
                    console.warn("Index load fallback:", e);
                }
            }

            _addCityToUI(city) {
                if (!city.id) return;
                const listDom = document.getElementById('city-list');
                if (!listDom) return;
                const opt = document.createElement('option');
                opt.value = city.name;
                listDom.appendChild(opt);
            }

            _bindEvents() {
                document.getElementById('lab-btn').onclick = () => {
                    window.location.href = './lab.html';
                };

                document.getElementById('lang-btn').onclick = () => {
                    const nextLang = this.lang === 'en' ? 'zh' : 'en';
                    this._applyLanguage(nextLang);
                };

                document.getElementById('locate-me-btn').onclick = () => {
                    const detectedId = this._detectUserCityId();
                    if (detectedId) {
                        this.dom.selector.value = detectedId;
                        this.changeLocation();
                    }
                };

                document.getElementById('copy-link-btn').onclick = (e) => {
                    e.preventDefault();
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        const toast = document.getElementById('copy-toast');
                        toast.textContent = (I18N[this.lang] || I18N.en).copied;
                        toast.classList.add('show');
                        setTimeout(() => toast.classList.remove('show'), 2200);
                    });
                };

                document.querySelectorAll('input[name="res"]').forEach(r => {
                    r.onchange = () => this.updateView();
                });

                document.querySelectorAll('input[name="span"]').forEach(s => {
                    s.onchange = () => this.updateView();
                });

                this.dom.humCheck.onchange = () => {
                    this.series.vol.applyOptions({ visible: this.dom.humCheck.checked });
                };

                const searchInput = document.getElementById('location-search-input');
                const triggerSearch = () => {
                    const val = searchInput.value.trim().toLowerCase();
                    if (!val) return;
                    const match = this.cityList.find(c => (c.name && c.name.toLowerCase() === val) || (c.name && c.name.toLowerCase().includes(val)) || (c.id && c.id.toLowerCase() === val));
                    if (match) {
                        this.dom.selector.value = match.id;
                        this.changeLocation();
                    }
                };

                searchInput.addEventListener('input', () => {
                    const val = searchInput.value.trim().toLowerCase();
                    if (val.length >= 2) triggerSearch();
                });

                searchInput.addEventListener('change', triggerSearch);
                searchInput.onclick = () => { searchInput.value = ''; };
            }

            async changeLocation() {
                const id = this.dom.selector.value;
                const city = this.locationConfig[id];
                if (!city) return;

                this.dom.container.style.opacity = 0.4;
                this.dom.coord.innerText = "Loading " + (city.name || id) + "...";

                try {
                    if (this.dataCache.has(id)) {
                        this.rawData = this.dataCache.get(id);
                    } else {
                        const years = city.years || fullYears;
                        let cityPath = formatStaticPath(city.path || '');
                        if (!cityPath.endsWith('/')) cityPath += '/';

                        const results = await Promise.allSettled(
                            years.map(y => fetch(`${cityPath}${city.id}_${y}.json`).then(r => r.ok ? r.json() : null).catch(() => null))
                        );

                        this.rawData = [];
                        results.forEach(res => {
                            if (res.status === 'fulfilled' && res.value) {
                                const chunk = res.value.values || res.value;
                                if (Array.isArray(chunk)) this.rawData = this.rawData.concat(chunk);
                            }
                        });

                        this.rawData.sort((a, b) => a.time - b.time);
                        this.rawData = this.rawData.filter((it, idx, arr) => idx === 0 || it.time > arr[idx-1].time);
                        if (this.rawData.length > 0) this.dataCache.set(id, [...this.rawData]);
                    }

                    const latDir = city.lat >= 0 ? 'N' : 'S';
                    const lonDir = city.lon >= 0 ? 'E' : 'W';
                    this.dom.coord.innerText = `${Math.abs(city.lat)}° ${latDir}, ${Math.abs(city.lon)}° ${lonDir}`;

                    if (this.globeIns) {
                        try {
                            this.globeIns.ringsData([{ lat: city.lat, lng: city.lon }]);
                            this.globeIns.pointOfView({ lat: city.lat, lng: city.lon, altitude: 2 }, 800);
                        } catch(e) {}
                    }

                    this.updateView();

                    const searchInput = document.getElementById('location-search-input');
                    if (searchInput) searchInput.value = city.name;

                    const cityDisplay = document.getElementById('selected-city-display');
                    if (cityDisplay) cityDisplay.textContent = city.name || '';

                    // 动态更新页面标题与社交分享链接，提升单城 SEO 与传播体验
                    document.title = `${city.name} 全球温度K线 / 气温蜡烛图 - WeatherCandle`;
                    const shareUrl = encodeURIComponent(`https://www.weathercandle.com/?city=${id}`);
                    const shareTitle = encodeURIComponent(`${city.name} Temperature Candlestick Chart on WeatherCandle`);
                    document.getElementById('share-x').href = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`;
                    document.getElementById('share-reddit').href = `https://www.reddit.com/submit?title=${shareTitle}&url=${shareUrl}`;
                } catch (e) {
                    console.error("Data fetch failed:", e);
                    this.dom.coord.innerText = "Load failed";
                } finally {
                    this.dom.container.style.opacity = 1;
                    history.replaceState(null, "", `?city=${id}`);
                }
            }

            updateView() {
                const resType = document.querySelector('input[name="res"]:checked').value;
                const spanVal = document.querySelector('input[name="span"]:checked').value;
                const processed = this._aggregate(this.rawData, resType);

                this.series.candle.setData([]);
                this.series.hLine.setData([]);

                this.series.candle.setData(processed);
                this.series.vol.setData(processed.map(d => {
                    const h = d.vol;
                    let alpha = h < 35 ? 0.1 : (h <= 80 ? 0.1 + ((h - 35) / (80 - 35)) * 0.6 : 0.9);
                    return {
                        time: d.time,
                        value: h,
                        color: `rgba(100, 181, 246, ${alpha})`
                    };
                }));

                const timeScale = this.chartIns.timeScale();

                if (resType === 'H') {
                    this.series.hLine.setData(processed.map(d => ({ time: d.time, value: d.close })));
                    this.series.hLine.applyOptions({ visible: true });
                    this.series.candle.applyOptions({
                        upColor: 'rgba(38,166,154,0.3)',
                        downColor: 'rgba(239,83,80,0.3)',
                        wickVisible: false,
                        priceLineColor: '#C0392B'
                    });
                    timeScale.applyOptions({ barSpacing: 6 });
                } else {
                    this.series.hLine.applyOptions({ visible: false });
                    this.series.candle.applyOptions({
                        upColor: '#4caf50',
                        downColor: '#fbc02d',
                        wickVisible: true,
                        wickUpColor: '#4caf50',
                        wickDownColor: '#fbc02d',
                        priceLineColor: ''
                    });
                    timeScale.applyOptions({ barSpacing: spanVal === '365' ? 4 : 10 });
                }

                if (processed.length > 0) {
                    if (spanVal === 'ALL') {
                        timeScale.fitContent();
                    } else {
                        const days = parseInt(spanVal, 10) || 365;
                        let barsCount = days;
                        if (resType === 'H') barsCount = Math.min(processed.length, days * 24);
                        else if (resType === 'W') barsCount = Math.ceil(days / 7);
                        else if (resType === 'M') barsCount = Math.ceil(days / 30);
                        else if (resType === 'Y') barsCount = Math.min(processed.length, 12);

                        const fromIdx = Math.max(0, processed.length - barsCount);
                        timeScale.setVisibleRange({
                            from: processed[fromIdx].time,
                            to: processed[processed.length - 1].time
                        });
                    }
                }
            }

            _aggregate(data, type) {
                if (!data || data.length === 0) return [];
                const res = []; let currentGroup = []; let lastKey = null;

                data.forEach(d => {
                    let key = d.time;
                    if (d.date && typeof d.date === 'string' && d.date.includes('/')) {
                        const parts = d.date.split('/');
                        if (type === 'D') key = `${parts[0]}-${parts[1]}-${parts[2]}`;
                        else if (type === 'M') key = `${parts[0]}-${parts[1]}`;
                        else if (type === 'Y') key = parts[0];
                    } else {
                        const dt = new Date(d.time * 1000);
                        if (type === 'D') key = `${dt.getUTCFullYear()}-${dt.getUTCMonth()}-${dt.getUTCDate()}`;
                        else if (type === 'M') key = `${dt.getUTCFullYear()}-${dt.getUTCMonth()}`;
                        else if (type === 'Y') key = dt.getUTCFullYear();
                    }

                    if (type === 'W') {
                        const dt = new Date(d.time * 1000);
                        const firstDay = new Date(dt.getUTCFullYear(), 0, 1);
                        key = `${dt.getUTCFullYear()}-w${Math.ceil((((dt - firstDay) / 86400000) + firstDay.getUTCDay() + 1) / 7)}`;
                    }

                    if (lastKey !== null && key !== lastKey) {
                        res.push(this._formatBar(currentGroup));
                        currentGroup = [];
                    }
                    currentGroup.push(d);
                    lastKey = key;
                });

                if (currentGroup.length > 0) res.push(this._formatBar(currentGroup));
                return res;
            }

            _formatBar(chunk) {
                return {
                    time: chunk[0].time, open: chunk[0].open,
                    high: Math.max(...chunk.map(d => d.high)), low: Math.min(...chunk.map(d => d.low)),
                    close: chunk[chunk.length - 1].close, vol: chunk.reduce((s, d) => s + (d.vol || 0), 0) / chunk.length
                };
            }

            _startClock() {
                const updateClock = () => {
                    const city = this.locationConfig[this.dom.selector.value];
                    if (city?.tz) {
                        try {
                            this.dom.clock.innerText = new Intl.DateTimeFormat('zh-Hans-CN', {
                                timeZone: city.tz, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
                            }).format(new Date());
                        } catch (e) {}
                    }
                };
                updateClock();
                setInterval(updateClock, 1000);
            }

            _handleTooltip(p) {
                if (!p.time || p.point.x < 0) { this.dom.tooltip.style.display = 'none'; return; }
                const d = p.seriesData.get(this.series.candle);
                const v = p.seriesData.get(this.series.vol);
                if (d) {
                    this.dom.tooltip.style.display = 'block';
                    this.dom.tooltip.style.left = (p.point.x + 15) + 'px';
                    this.dom.tooltip.style.top = (p.point.y + 15) + 'px';
                    this.dom.tooltip.innerHTML = `
                        <div style="color:#4caf50; font-weight:600; margin-bottom:4px; border-bottom:1px solid rgba(255,255,255,0.1);">Details</div>
                        <div style="display:grid; grid-template-columns:50px 1fr; gap:2px; font-family:monospace;">
                            <span style="color:#999">MAX:</span><b style="color:#ff5252">${d.high.toFixed(1)}℃</b>
                            <span style="color:#999">OPEN:</span><b style="color:#eee">${d.open.toFixed(1)}℃</b>
                            <span style="color:#999">CLOSE:</span><b style="color:#eee">${d.close.toFixed(1)}℃</b>
                            <span style="color:#999">MIN:</span><b style="color:#448aff">${d.low.toFixed(1)}℃</b>
                            <div style="grid-column: span 2; border-top:1px dashed #444; margin-top:4px; padding-top:4px; display:flex; justify-content:space-between">
                                <span style="color:#999">HUM:</span>
                                <b style="color:#b2ebf2">${v ? v.value.toFixed(1) : '0.0'}%</b>
                            </div>
                        </div>`;
                }
            }
        }

        const app = new MeteoApp();
        app.init();
    </script>
</body>
</html>